NODE_ENV=development
DEMO_MODE=true
API_PORT=3000
DATABASE_URL=postgres://borneo:borneo@localhost:5432/borneo
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=borneo
S3_SECRET_KEY=borneo-secret
S3_BUCKET=borneo

# Map tiles (D-187). Unset: public OSM tiles in dev; no map in production builds.
# VITE_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=

# Auth (Better Auth). Required in production; development falls back to a fixed dev secret.
# AUTH_SECRET=at-least-32-random-characters
# Web origin the browser uses; the API is served to it at <WEB_ORIGIN>/api.
# WEB_ORIGIN=http://localhost:5173
# Proxies whose X-Forwarded-For the API believes (client IPs for auth rate limits, D-190).
# TRUST_PROXY=127.0.0.1,::1
