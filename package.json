{
  "name": "borneo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @borneo/web --filter @borneo/api dev",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm depcruise && pnpm check:rules && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "check:rules": "node tooling/src/cli.ts",
    "db:generate": "pnpm --filter @borneo/api db:generate",
    "db:migrate": "pnpm --filter @borneo/api db:migrate",
    "db:reset": "pnpm --filter @borneo/api db:reset",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lefthook": "^2.1.17",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
